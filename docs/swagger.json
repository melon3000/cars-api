
{
  "openapi": "3.0.0",
  "info": {
    "title": "Cars API",
    "version": "1.0.0",
    "description": "API for managing cars"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/cars": {
      "get": {
        "summary": "Get all cars",
        "responses": {
          "200": {
            "description": "List of cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Car"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a new car",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCar"
              },
              "example": {
                "id": 4,
                "brand": "Volvo",
                "model": "XC60",
                "year": 2024
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Car created successfully"
          },
          "400": {
            "description": "Missing or invalid parameters"
          },
          "409": {
            "description": "A car with this ID already exists"
          }
        }
      }
    },
    "/cars/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get a car by ID",
        "responses": {
          "200": {
            "description": "Car found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Car"
                }
              }
            }
          },
          "400": {
            "description": "Invalid car ID"
          },
          "404": {
            "description": "Car not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a car by ID",
        "responses": {
          "204": {
            "description": "Car deleted successfully"
          },
          "400": {
            "description": "Invalid car ID"
          },
          "404": {
            "description": "Car not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Car": {
        "type": "object",
        "required": ["id", "brand", "model", "year"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "brand": {
            "type": "string",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "example": "Corolla"
          },
          "year": {
            "type": "integer",
            "example": 2022
          }
        }
      },
      "NewCar": {
        "type": "object",
        "required": ["id", "brand", "model", "year"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1886,
            "maximum": 2026
          }
        }
      }
    }
  }
}
